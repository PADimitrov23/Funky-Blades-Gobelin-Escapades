[sub_resource type="GDScript" id="GDScript_yy1gw"]
resource_name = "tempest_burst_spell"
script/source = "extends Spell

@export var area_of_effect: SphereShape3D

func _on_collide(body: Node3D) -> void:
	if body is Player:
		return
	
	print(get_tree().get_node_count_in_group(\"enemies\"))
	for enemy: Enemy in get_tree().get_nodes_in_group(\"enemies\"):
		enemy.take_damage(3 * (7 - int(global_position.distance_squared_to(enemy.global_position))))
	
	queue_free()
"

